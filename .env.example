# =============================================================================
# LineupOpt — Environment Configuration
# =============================================================================
# Copy to .env and fill in. Every source below is annotated with whether it
# is (a) free/no-key/no-auth, (b) free but requires signup for a key, or
# (c) paid/ToS-restricted, in which case we NEVER scrape it — instead we
# provide a manual CSV/JSON import adapter so you can legitimately bring
# your own export from that provider.
# =============================================================================

# --- Core app -----------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me

# --- Database -------------------------------------------------------------
# Local dev defaults to SQLite (no setup required). For production, point
# at Postgres. See docker-compose.yml for a local Postgres+Redis stack.
DATABASE_URL=sqlite:///./lineupopt.db
# DATABASE_URL=postgresql+psycopg://lineupopt:lineupopt@localhost:5432/lineupopt

REDIS_URL=redis://localhost:6379/0

# --- DraftKings (FREE, no key needed) -------------------------------------
# We use DraftKings' own public site JSON endpoints (the same calls DK's
# website makes client-side to render the lineup builder — no auth token,
# no login required) plus DK's official "Export to CSV" salary file as a
# fully legitimate, zero-scraping fallback/primary path.
DK_API_BASE_URL=https://api.draftkings.com
DK_SITE_BASE_URL=https://www.draftkings.com
DK_REQUEST_DELAY_SECONDS=1.0

# --- nflverse-data (FREE, public GitHub release assets, no key) -----------
# Play-by-play, rosters, schedules, snap counts, NGS advanced stats.
NFLVERSE_DATA_BASE_URL=https://github.com/nflverse/nflverse-data/releases/download

# --- Weather: Open-Meteo (FREE, no key) ------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Betting lines: The Odds API (free tier, REQUIRES a key) --------------
# Sign up at https://the-odds-api.com/ — free tier available.
# If left blank, the BettingSource falls back to manual CSV/JSON import.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# --- Injuries: ESPN public JSON (FREE, no key, undocumented but widely
#     used the same way DK's own endpoints are) ----------------------------
ESPN_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl

# --- Third-party projection sources (PAID / ToS-restricted) ---------------
# FantasyPros, ESPN premium projections, and most "DFS projections" products
# require a paid subscription and forbid scraping in their ToS. We do NOT
# scrape these. Instead:
#   1. If a provider offers a legitimate API with a key, set it below and
#      the corresponding ProjectionSource adapter will call it directly.
#   2. Otherwise, export projections to CSV from the provider's site and
#      use the "Manual Projection Import" adapter (POST /api/projections/import)
#      to load them — this is the supported path out of the box.
FANTASYPROS_API_KEY=

# --- AI assistant (OPTIONAL — for AI lineup ranking / chat layer) ---------
# The AI layer only ever reads structured DB/model output; it never
# fabricates stats. Without a key, AI ranking falls back to the deterministic
# rule-based evaluator (ai/lineup_evaluator.py) and the chat endpoint is disabled.
ANTHROPIC_API_KEY=

# --- Simulation ------------------------------------------------------------
DEFAULT_SIMULATION_COUNT=10000
MAX_SIMULATION_COUNT=50000
